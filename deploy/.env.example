# Generated by configure-deploy; no secrets in dotenv.
CONTROL_DOMAIN=control.example.com
# Production requires an actual registry repo@sha256 digest.
RELAY_IMAGE=
CADDY_IMAGE=
NODE_IMAGE=
NGINX_IMAGE=
RELAY_UID=
RELAY_GID=
DEPLOY_MODE=production
# Optional positive integer limits (validated before serve).
HEARTBEAT_MS=10000
LEASE_TTL_MS=30000
BUFFERED_BYTES=4194304
MAX_CALLS=16
MAX_STREAMS=16
MAX_UPLOADS=2
