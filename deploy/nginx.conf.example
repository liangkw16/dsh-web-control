# Place in http context; replace server_name and certificate paths.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name control.example.com;
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    access_log off;
    error_log /dev/stderr crit;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://relay:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Exact hashes for native DSH inline styles exceed nginx's default header buffer.
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_buffering off;
        # Compress immutable native UI bytes on the wire; JSON/control traffic is excluded.
        gzip on;
        gzip_types text/javascript application/javascript text/css;
        gzip_min_length 1024;
        gzip_comp_level 5;
        gzip_vary on;
        proxy_read_timeout 60s;
        client_max_body_size 4k;
    }
}
