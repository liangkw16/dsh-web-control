{
  "name": "dsh-web-control",
  "version": "0.1.0",
  "type": "module",
  "description": "Persistent remote control for stock DSH through an authenticated relay",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "qrcode": "1.5.4",
    "ws": "8.18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangkw16/dsh-web-control.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/liangkw16/dsh-web-control#readme",
  "bugs": {
    "url": "https://github.com/liangkw16/dsh-web-control/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "self-hosted",
    "web-control"
  ],
  "engines": {
    "node": ">=24 <25"
  }
}
